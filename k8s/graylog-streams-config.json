{
  "streams": [
    {
      "title": "📱 FileFlow Backend (Java/Hibernate)",
      "description": "Logs do backend Java com queries Hibernate e operações de negócio",
      "rules": [
        {
          "field": "k8s_namespace_name",
          "type": 1,
          "value": "file-flow",
          "inverted": false
        },
        {
          "field": "k8s_container_name", 
          "type": 1,
          "value": "fileflow",
          "inverted": false
        }
      ],
      "matching_type": "AND",
      "remove_matches_from_default_stream": true,
      "index_set_id": "000000000000000000000001"
    },
    {
      "title": "🌐 FileFlow Frontend (Nginx/HTTP)",
      "description": "Logs do frontend com requests HTTP, access logs e erros de navegação",
      "rules": [
        {
          "field": "k8s_namespace_name",
          "type": 1,
          "value": "file-flow",
          "inverted": false
        },
        {
          "field": "k8s_container_name",
          "type": 1,
          "value": "fileflow-front", 
          "inverted": false
        }
      ],
      "matching_type": "AND",
      "remove_matches_from_default_stream": true,
      "index_set_id": "000000000000000000000001"
    },
    {
      "title": "🗄️ Database (PostgreSQL)",
      "description": "Logs do banco de dados PostgreSQL com conexões e queries SQL",
      "rules": [
        {
          "field": "k8s_namespace_name",
          "type": 1,
          "value": "file-flow",
          "inverted": false
        },
        {
          "field": "k8s_container_name",
          "type": 1,
          "value": "postgres",
          "inverted": false
        }
      ],
      "matching_type": "AND", 
      "remove_matches_from_default_stream": true,
      "index_set_id": "000000000000000000000001"
    },
    {
      "title": "🔴 Cache (Redis)",
      "description": "Logs do Redis com operações de cache e memória",
      "rules": [
        {
          "field": "k8s_namespace_name",
          "type": 1,
          "value": "file-flow",
          "inverted": false
        },
        {
          "field": "k8s_container_name",
          "type": 1,
          "value": "redis",
          "inverted": false
        }
      ],
      "matching_type": "AND",
      "remove_matches_from_default_stream": true,
      "index_set_id": "000000000000000000000001"
    },
    {
      "title": "❌ Errors - FileFlow Application",
      "description": "Todos os erros da aplicação FileFlow concentrados em um stream",
      "rules": [
        {
          "field": "k8s_namespace_name",
          "type": 1,
          "value": "file-flow",
          "inverted": false
        },
        {
          "field": "message",
          "type": 2,
          "value": "(?i)(error|exception|failed|warn|warning)",
          "inverted": false
        }
      ],
      "matching_type": "AND",
      "remove_matches_from_default_stream": false,
      "index_set_id": "000000000000000000000001"
    },
    {
      "title": "👤 User Activity (Login/Files)",
      "description": "Atividades de usuários: login, upload, download de arquivos",
      "rules": [
        {
          "field": "k8s_namespace_name",
          "type": 1,
          "value": "file-flow",
          "inverted": false
        },
        {
          "field": "message",
          "type": 2,
          "value": "(?i)(username|login|files|upload|download|insert into files|select.*files)",
          "inverted": false
        }
      ],
      "matching_type": "AND",
      "remove_matches_from_default_stream": false,
      "index_set_id": "000000000000000000000001"
    }
  ]
} 